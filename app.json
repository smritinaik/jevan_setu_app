{
  "expo": {
    "name": "JeevanSetu",
    "slug": "jevan_setu_app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "jevansetuapp",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "com.smritinaik.jevansetu",
      "adaptiveIcon": {
        "backgroundColor": "#FFE5D0",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFE5D0",
          "image": "./assets/icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "JeevanSetu shares the ambulance location with traffic police during an emergency."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "dd617f14-d3fe-487d-9f3c-89acc730226d"
      }
    }
  }
}
